# ====================
# MinerU API
# ====================
MINERU_API_TOKEN=sk-SHPbyakztCSpyZ3SVzG2C2GiHo8qegfgD7yXmB9qOEz8lCuS
MINERU_BASE_URL=https://mineru.net/api/v4
# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=D:/ai_models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (DashScope compatible) — LLM_BACKEND=openai 时使用
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-ws-H.RXPIIRD.kMbb.MEUCIEeiGprSsKxFRjZ-xaIm4Mu7yv1Nimv5XULHdHs2Knt0AiEA4NZOrYZMtnAwcu6gY6xFp4xefbzQm-NI3pvEtc1MCnA
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 LLM 模型（远程名；本地模式可留作备注）
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型（远程名）
VL_MODEL=qwen3-vl-flash
# 商品名识别模型（远程名）
ITEM_MODEL=qwen-flash

# ====================
# 本地 transformers LLM / VL（LLM_BACKEND=transformers）
# ====================
# openai | transformers
LLM_BACKEND=openai
# 文本模型本地路径（先跑 python tool/download_local_llm.py，用脚本打印的真实路径覆盖）
LLM_LOCAL_PATH=D:\ai_models\modelscope_cache\models\Qwen--Qwen2.5-1.5B-Instruct\snapshots\master
# 视觉模型本地路径
VL_LOCAL_PATH=D:\ai_models\modelscope_cache\models\Qwen--Qwen2.5-VL-3B-Instruct\snapshots\master
# 推理设备
LLM_DEVICE=cuda:0
# 半精度
LLM_FP16=True
# 最大生成 token（文本）；VL 摘要代码内还会再压到 ≤128
LLM_MAX_NEW_TOKENS=512
# VL 视觉 token 范围（越小越省显存/越快；256*28*28=200704，512*28*28=401408）
VL_MIN_PIXELS=200704
VL_MAX_PIXELS=401408
# 图片摘要完成后释放 VL 模型（给 BGE / 文本 LLM 腾显存）
LLM_RELEASE_VL_AFTER_USE=True

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI--bge-m3\snapshots\master
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cuda:0
# 是否使用半精度（True/False）
BGE_FP16=True
# BGE 重排序模型路径
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\BAAI\bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cuda:0
# 重排序模型半精度
BGE_RERANKER_FP16=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度（OpenAI text-embedding-v4）
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://192.168.100.100:19530
# 知识库切片集合名
CHUNKS_COLLECTION=travel_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=travel_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://192.168.100.100:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=192.168.100.100:9000
# 访问密钥
MINIO_ACCESS_KEY=minioadmin
# 私有密钥
MINIO_SECRET_KEY=minioadmin
# 存储桶名称
MINIO_BUCKET_NAME=Travel_knowledge-base
# 图片上传目录
MINIO_IMG_DIR=upload-images

# ====================
# Other / MCP Services
# ====================
# 百炼MCP WebSearch的SSE接口地址（固定值，无需修改）
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ====================
# 重排序模型
# ====================
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落
# ====================
# 数据根目录
DATA_BASED_ROOT_DIR=D:\file